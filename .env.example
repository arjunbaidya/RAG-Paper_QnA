# Copy to .env and edit. Defaults use a local Ollama server.

# --- LLM: any OpenAI-compatible endpoint ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Hosted example (OpenAI, Groq, OpenRouter, Together... all speak this API):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<model name from your provider>

# --- Embeddings ---
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# For models without a query instruction (e.g. all-MiniLM-L6-v2) set:
# QUERY_INSTRUCTION=
